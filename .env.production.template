# =============================================================================
# Discovery Engine — Production Environment Template
# =============================================================================
# Copy this file to .env and fill in your values.
# Validate with: python scripts/validate_env.py --env-file .env
#
# Strict validation is ON by default — startup will abort if errors are found.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------------

# Path to the SQLite database. Keep it outside the repo working tree.
DISCOVERY_DB_PATH=/var/lib/harmonic/signals.db

# Strict config validation (true = abort on errors, false = log and continue)
STRICT_CONFIG_VALIDATION=true

# Delivery mode: staging_only | manual_publish | batch_publish | auto_publish
#   staging_only   — no Notion writes (safe default)
#   manual_publish — operator triggers individual pushes
#   batch_publish  — operator triggers batch commits
#   auto_publish   — pipeline pushes automatically (requires all secrets)
DELIVERY_MODE=staging_only

# -----------------------------------------------------------------------------
# Secrets — API Keys
# -----------------------------------------------------------------------------

# Notion CRM integration (required for manual_publish / batch_publish / auto_publish)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# GitHub API token (required for github collector + CI regression check)
GITHUB_TOKEN=

# Google Gemini API key (required when LLM_THESIS_MODE != off)
# Free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI API key (optional — for multi-LLM consensus via Maestro)
OPENAI_API_KEY=

# GNews API key (optional — enables news_api collector)
# Free tier: https://gnews.io (100 requests/day)
GNEWS_API_KEY=

# Optional collector keys (enable when available)
# COMPANIES_HOUSE_API_KEY=
# PH_API_KEY=
# PROXYCURL_API_KEY=
# CRUNCHBASE_API_KEY=
# OPENCORPORATES_API_KEY=

# -----------------------------------------------------------------------------
# Feature Flags — Progressive Activation
# -----------------------------------------------------------------------------
# All features default to DISABLED. Enable them progressively using the
# 4-step activation sequence in docs/runbooks/feature-activation.md.
#
# Run pre-flight before each step: python scripts/preflight_check.py --json

# --- Step 1: Shadow Activation (observe-only, no mutations) ---
# LLM_THESIS_MODE=shadow
# ML_ENABLEMENT=shadow
# V2_ENABLEMENT=shadow
# USE_SHADOW_ENTITY_RESOLUTION=true

# --- Step 0D: Claim facts shadow ---
# USE_CLAIM_FACTS=true

# --- Step 2: Low-Risk Writes (thin files, drift monitoring) ---
# USE_THIN_FILES=true
# DRIFT_MONITORING_ENABLED=active

# --- Step 3: Manual Write Operations ---
# LLM_THESIS_MODE=active
# ML_ENABLEMENT=live
# DELIVERY_MODE=manual_publish
# MERGE_WRITES_ENABLED=shadow
# BULK_TRIAGE_ENABLED=active
# HUNTER_PROMOTE_ENABLED=active

# --- Step 4: Batch Publish (full production) ---
# DELIVERY_MODE=batch_publish
# MERGE_WRITES_ENABLED=active
# USE_PHASE_G_IDENTITY_RESOLUTION=true
# USE_CLAIM_FACTS=true

# -----------------------------------------------------------------------------
# Thresholds (all must be in [0.0, 1.0] — defaults are sensible)
# -----------------------------------------------------------------------------
# Uncomment and adjust only if you need to override defaults.

# MATCHING_HIGH_CONFIDENCE=0.7
# MATCHING_MEDIUM_CONFIDENCE=0.4
# MATCHING_IS_FIT_THRESHOLD=0.5
# MATCHING_QUALIFIED_THRESHOLD=0.6
# MATCHING_HELD_THRESHOLD=0.3
# MATCHING_THESIS_THRESHOLD=0.5
# WORKFLOW_HOLD_THRESHOLD=0.4
# WORKFLOW_SKIP_LLM_THRESHOLD=0.8
# WORKFLOW_KEYWORD_HIGH=0.7
# WORKFLOW_KEYWORD_LOW=0.4
# WORKFLOW_LLM_REVIEW_THRESHOLD=0.5
# WORKFLOW_LLM_AUTO_APPROVE_THRESHOLD=0.8

# -----------------------------------------------------------------------------
# Advanced / Deployment
# -----------------------------------------------------------------------------

# Merge rollback TTL (hours) — how long a merge can be rolled back
# MERGE_ROLLBACK_TTL_HOURS=24

# API server binding
# API_HOST=0.0.0.0
# API_PORT=8000
