# OpenAI Integration Environment Variables
# Copy to .env or export these variables

# OpenAI API Key (required for API-based integration)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: Codex CLI settings
# These are set automatically when using 'codex login'
CODEX_SANDBOX=read-only
CODEX_APPROVAL=suggest

# Model preferences (optional)
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_REASONING_MODEL=o1-preview

# Rate limiting (optional)
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
