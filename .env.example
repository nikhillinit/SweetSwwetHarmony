# Discovery Engine Environment Variables
# Copy to .env and fill in your values

# =============================================================================
# LLM CLASSIFICATION (Consumer Engine)
# =============================================================================
# Google AI Studio (FREE - 1.5M tokens/day)
# Get at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (optional fallback, ~$0.002/signal)
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Kimi / Moonshot AI (alternative LLM for Maestro workflow)
# Get at: https://platform.moonshot.cn/console/api-keys
# Pricing: $0.60/M input, $2.50/M output
# Context: Up to 256K tokens (moonshot-v1-128k model)
KIMI_API_KEY=your_kimi_api_key_here
# Alternative env var name (both work)
# MOONSHOT_API_KEY=your_kimi_api_key_here

# =============================================================================
# PDF PROFILER PRIVACY CONTROLS (NDA Protection)
# =============================================================================
# CRITICAL: These flags prevent sending sensitive PDF content to cloud APIs
# Default: Both disabled (local-only extraction)

# Allow sending PDF text to cloud LLM (Gemini) for structured extraction
# WARNING: Only enable if PDFs do NOT contain confidential information
# Default: false (local PyMuPDF extraction only)
ALLOW_CLOUD_LLM=false

# Allow sending PDF images to cloud vision models (Gemini Vision)
# WARNING: Only enable for non-sensitive scanned PDFs
# Requires ALLOW_CLOUD_LLM=true as well
# Default: false (local extraction only)
ALLOW_CLOUD_VISION=false

# =============================================================================
# NOTION (Required for CRM integration)
# =============================================================================
NOTION_API_KEY=secret_xxx
NOTION_DATABASE_ID=xxx

# Consumer Engine Inbox Database
NOTION_INBOX_DATABASE_ID=xxx

# =============================================================================
# GITHUB (Required for GitHub collector)
# =============================================================================
# Create at: https://github.com/settings/tokens
# Scope: public_repo (read-only)
GITHUB_TOKEN=ghp_xxx

# =============================================================================
# COLLECTOR API KEYS (Optional)
# =============================================================================

# UK Companies House
# Register at: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=xxx

# Product Hunt
# Get at: https://api.producthunt.com/v2/oauth/applications
PH_API_KEY=xxx

# OpenCorporates
# Register at: https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_KEY=xxx

# Proxycurl (LinkedIn data)
# Get at: https://nubela.co/proxycurl/
PROXYCURL_API_KEY=xxx

# Crunchbase
# Get at: https://data.crunchbase.com/docs/using-the-api
CRUNCHBASE_API_KEY=xxx

# Tavily (Web Search for Curated Discovery - Phase 2)
# Get at: https://tavily.com (free tier available)
TAVILY_API_KEY=tvly-xxx

# =============================================================================
# DATABASE (Signal Storage)
# =============================================================================
# SQLite database path for local signal storage
# Default: signals.db in current directory
DISCOVERY_DB_PATH=signals.db

# PostgreSQL (optional - for production deployments)
# Use read-only credentials for local development
DATABASE_URL=postgresql://readonly:xxx@localhost:5432/discovery

# =============================================================================
# DISTRIBUTION LAYER (Weekly Digest Emails)
# =============================================================================
# Public URLs for email links
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_PROFILE_BASE_URL=http://localhost:8000

# Digest recipients (comma-separated)
DIGEST_FROM_EMAIL=deals@localhost
DIGEST_TO_EMAILS=gp@example.com

# Email transport: console (dev), resend (prod), smtp (fallback)
EMAIL_TRANSPORT=console

# Resend (recommended for production)
# Get at: https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# SMTP (optional fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@gmail.com
SMTP_PASSWORD=app_password

# =============================================================================
# V2 POLICY CONTROLS (Negative Keyword Policy v2)
# =============================================================================
# Controls for the v2 policy system in ThesisMatcher.
# Default: disabled (v1 hardcoded constants used)

# V2_ENABLEMENT: disabled | shadow | live
# - disabled: Use v1 hardcoded NEGATIVE_KEYWORDS (zero I/O cost)
# - shadow: Load v2 policy, score with both v1 and v2, log diffs (no routing change)
# - live: Load v2 policy, use v2 scoring for actual routing decisions
V2_ENABLEMENT=disabled

# POLICY_LOADER_MODE: permissive | strict
# - permissive: Log warnings on missing/malformed policies, continue
# - strict: Raise RuntimeError if required policies missing/malformed
# Auto-derived: shadow/live -> strict, disabled -> permissive
# POLICY_LOADER_MODE=strict

# V2_POLICY_DIR: Optional explicit path to policy directory
# If not set, auto-discovers config/v2/ or config/ based on marker file
# V2_POLICY_DIR=/path/to/custom/policies

# V2_EXECUTION_ENABLED: true | false
# Whether v2 scoring is active. Auto-derived from enablement.
# shadow/live -> true, disabled -> false
# V2_EXECUTION_ENABLED=true

# =============================================================================
# QUALITY OPS (LLM Thesis Classification)
# =============================================================================
# GOOGLE_API_KEY is also used by the quality ops thesis classifier via google-genai.
# If already set above for LLM Classification, no additional config needed.

# LLM Thesis Classification Mode (Phase 9 Quality Ops Integration)
# Three modes for safe rollout and testing:
#   off     = No LLM calls (keyword-only classification) - DEFAULT
#   shadow  = Run LLM, store results in DB, DON'T affect routing (for testing)
#   active  = Full integration, LLM scores affect confidence & routing (production)
# Rate limit: Gemini free tier = 15 RPM, 1500 RPD
LLM_THESIS_MODE=off

# LLM Tuning Thresholds (externalized for easy adjustment)
LLM_KEYWORD_GATE_THRESHOLD=0.15  # Skip LLM if keyword score < this (obvious non-fit)
LLM_AGREEMENT_THRESHOLD=0.7      # Agreement = both keyword and LLM >= this
LLM_DISAGREEMENT_THRESHOLD=0.4   # Disagreement = one >= 0.7 and other < this
CONFIDENCE_BOOST_AGREEMENT=0.10  # Confidence boost when keyword + LLM agree
CONFIDENCE_PENALTY_DISAGREEMENT=0.15  # Confidence penalty when keyword + LLM disagree

# =============================================================================
# STARTUP CONFIG VALIDATION
# =============================================================================
# When true, API and CLI abort on config errors (missing keys, invalid values).
# When false (default), log warnings and continue.
STRICT_CONFIG_VALIDATION=false

# =============================================================================
# DOCKER DEPLOYMENT
# =============================================================================
# API port (used by docker-compose)
# API_PORT=8000

# Database path inside container (set automatically by docker-compose)
# DISCOVERY_DB_PATH=/app/data/signals.db

# =============================================================================
# SHADOW OBSERVABILITY
# =============================================================================
# View shadow feature data volumes and health:
#   python run_pipeline.py shadow-status --days 7
#
# For detailed v2 policy shadow analysis:
#   python scripts/shadow_report.py export --since-days 7 --out shadow.jsonl
#   python scripts/shadow_report.py report --input shadow.jsonl

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - Never commit .env to git (it's in .gitignore)
# - Use read-only credentials locally
# - Write credentials only in CI/CD
