# Discovery Engine Environment Variables
# Copy to .env and fill in your values

# =============================================================================
# LLM CLASSIFICATION (Consumer Engine)
# =============================================================================
# Google AI Studio (FREE - 1.5M tokens/day)
# Get at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (optional fallback, ~$0.002/signal)
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# NOTION (Required for CRM integration)
# =============================================================================
NOTION_API_KEY=secret_xxx
NOTION_DATABASE_ID=xxx

# Consumer Engine Inbox Database
NOTION_INBOX_DATABASE_ID=xxx

# =============================================================================
# GITHUB (Required for GitHub collector)
# =============================================================================
# Create at: https://github.com/settings/tokens
# Scope: public_repo (read-only)
GITHUB_TOKEN=ghp_xxx

# =============================================================================
# UK COMPANIES HOUSE (Optional)
# =============================================================================
# Register at: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=xxx

# =============================================================================
# DATABASE (Optional - for signal storage)
# =============================================================================
# Use read-only credentials for local development
DATABASE_URL=postgresql://readonly:xxx@localhost:5432/discovery

# =============================================================================
# DISTRIBUTION LAYER (Weekly Digest Emails)
# =============================================================================
# Public URLs for email links
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_PROFILE_BASE_URL=http://localhost:8000

# Digest recipients (comma-separated)
DIGEST_FROM_EMAIL=deals@localhost
DIGEST_TO_EMAILS=gp@example.com

# Email transport: console (dev), resend (prod), smtp (fallback)
EMAIL_TRANSPORT=console

# Resend (recommended for production)
# Get at: https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# SMTP (optional fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@gmail.com
SMTP_PASSWORD=app_password

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - Never commit .env to git (it's in .gitignore)
# - Use read-only credentials locally
# - Write credentials only in CI/CD
