{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sweetswwetharmony.local/hermes/ledger_audit_report.schema.json",
  "title": "Hermes Ledger Audit Report",
  "type": "object",
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["code", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "line": {"type": "integer", "minimum": 1},
        "runId": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "raw": {"type": "string"},
        "subsystem": {"type": "string", "minLength": 1},
        "resourceId": {"type": "string", "minLength": 1},
        "evidencePath": {"type": "string", "minLength": 1},
        "remediationHint": {"type": "string", "minLength": 1},
        "observedDigest": {"type": "string", "minLength": 1},
        "expectedDigest": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "auditId",
    "generatedAt",
    "dryRun",
    "mutationCommitted",
    "task",
    "ledgerRoot",
    "ledgerIndex",
    "checksRun",
    "summary",
    "operatorSummary",
    "findings",
    "subsystems",
    "reportArtifacts"
  ],
  "properties": {
    "auditId": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "dryRun": {"const": true},
    "mutationCommitted": {"const": false},
    "task": {"const": "ledger-audit"},
    "ledgerRoot": {"type": "string", "minLength": 1},
    "ledgerIndex": {"type": "string", "minLength": 1},
    "checksRun": {
      "type": "array",
      "items": {"enum": ["index", "runs", "artifacts"]},
      "minItems": 1
    },
    "summary": {
      "type": "object",
      "required": [
        "indexLines",
        "validIndexEntries",
        "malformedIndexEntries",
        "rawIndexRows",
        "uniqueRunDirsChecked",
        "missingRunDirs",
        "missingArtifacts"
      ],
      "properties": {
        "indexLines": {"type": "integer", "minimum": 0},
        "validIndexEntries": {"type": "integer", "minimum": 0},
        "malformedIndexEntries": {"type": "integer", "minimum": 0},
        "rawIndexRows": {"type": "integer", "minimum": 0},
        "uniqueRunDirsChecked": {"type": "integer", "minimum": 0},
        "missingRunDirs": {"type": "integer", "minimum": 0},
        "missingArtifacts": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "operatorSummary": {
      "type": "object",
      "required": [
        "status",
        "severityThreshold",
        "totalFindings",
        "blockingFindings",
        "severityCounts",
        "subsystemsWithFindings",
        "nextAction"
      ],
      "properties": {
        "status": {"enum": ["pass", "action_required"]},
        "severityThreshold": {"enum": ["low", "medium", "high", "critical"]},
        "totalFindings": {"type": "integer", "minimum": 0},
        "blockingFindings": {"type": "integer", "minimum": 0},
        "severityCounts": {
          "type": "object",
          "required": ["low", "medium", "high", "critical"],
          "properties": {
            "low": {"type": "integer", "minimum": 0},
            "medium": {"type": "integer", "minimum": 0},
            "high": {"type": "integer", "minimum": 0},
            "critical": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "subsystemsWithFindings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "nextAction": {
          "enum": [
            "no_action_required",
            "review_non_blocking_findings",
            "review_blocking_findings"
          ]
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "subsystems": {
      "type": "object",
      "required": [
        "restore_sqlite",
        "governance_config",
        "collector_promotion",
        "suppression_outbox",
        "bypass_lifecycle"
      ],
      "properties": {
        "restore_sqlite": {
          "type": "object",
          "required": [
            "subsystem",
            "ownerTask",
            "enabled",
            "runsChecked",
            "resourcesChecked",
            "findings"
          ],
          "properties": {
            "subsystem": {"const": "restore_sqlite"},
            "ownerTask": {"const": "restore-db"},
            "enabled": {"type": "boolean"},
            "runsChecked": {"type": "integer", "minimum": 0},
            "resourcesChecked": {"type": "integer", "minimum": 0},
            "findings": {
              "type": "array",
              "items": {"$ref": "#/$defs/finding"}
            }
          },
          "additionalProperties": false
        },
        "governance_config": {
          "type": "object",
          "required": [
            "subsystem",
            "ownerTask",
            "enabled",
            "runsChecked",
            "resourcesChecked",
            "findings"
          ],
          "properties": {
            "subsystem": {"const": "governance_config"},
            "ownerTask": {"const": "governance/config-promote"},
            "enabled": {"type": "boolean"},
            "runsChecked": {"type": "integer", "minimum": 0},
            "resourcesChecked": {"type": "integer", "minimum": 0},
            "findings": {
              "type": "array",
              "items": {"$ref": "#/$defs/finding"}
            }
          },
          "additionalProperties": false
        },
        "collector_promotion": {
          "type": "object",
          "required": [
            "subsystem",
            "ownerTask",
            "enabled",
            "runsChecked",
            "resourcesChecked",
            "findings"
          ],
          "properties": {
            "subsystem": {"const": "collector_promotion"},
            "ownerTask": {"const": "collector-promote"},
            "enabled": {"type": "boolean"},
            "runsChecked": {"type": "integer", "minimum": 0},
            "resourcesChecked": {"type": "integer", "minimum": 0},
            "findings": {
              "type": "array",
              "items": {"$ref": "#/$defs/finding"}
            }
          },
          "additionalProperties": false
        },
        "suppression_outbox": {
          "type": "object",
          "required": [
            "subsystem",
            "ownerTask",
            "enabled",
            "runsChecked",
            "resourcesChecked",
            "findings"
          ],
          "properties": {
            "subsystem": {"const": "suppression_outbox"},
            "ownerTask": {"const": "suppression-sync/outbox-purge"},
            "enabled": {"type": "boolean"},
            "runsChecked": {"type": "integer", "minimum": 0},
            "resourcesChecked": {"type": "integer", "minimum": 0},
            "findings": {
              "type": "array",
              "items": {"$ref": "#/$defs/finding"}
            }
          },
          "additionalProperties": false
        },
        "bypass_lifecycle": {
          "type": "object",
          "required": [
            "subsystem",
            "ownerTask",
            "enabled",
            "runsChecked",
            "resourcesChecked",
            "activeRecords",
            "expiredRecords",
            "remediatedRecords",
            "revokedRecords",
            "findings"
          ],
          "properties": {
            "subsystem": {"const": "bypass_lifecycle"},
            "ownerTask": {"const": "ledgered-bypass-artifacts"},
            "enabled": {"type": "boolean"},
            "runsChecked": {"type": "integer", "minimum": 0},
            "resourcesChecked": {"type": "integer", "minimum": 0},
            "activeRecords": {"type": "integer", "minimum": 0},
            "expiredRecords": {"type": "integer", "minimum": 0},
            "remediatedRecords": {"type": "integer", "minimum": 0},
            "revokedRecords": {"type": "integer", "minimum": 0},
            "findings": {
              "type": "array",
              "items": {"$ref": "#/$defs/finding"}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reportArtifacts": {
      "type": "object",
      "required": ["json", "markdown"],
      "properties": {
        "json": {"const": "ledger_audit_report.json"},
        "markdown": {"const": "ledger_audit_report.md"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
