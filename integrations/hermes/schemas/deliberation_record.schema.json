{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sweetswwetharmony.local/hermes/deliberation_record.schema.json",
  "title": "Hermes Deliberation Record",
  "type": "object",
  "required": [
    "contractVersion",
    "deliberationId",
    "createdAt",
    "task",
    "mode",
    "dryRun",
    "mutationCommitted",
    "artifactCommit",
    "input",
    "panel",
    "reviewerPolicy",
    "synthesizer",
    "consensus",
    "freshnessTtlSeconds"
  ],
  "properties": {
    "contractVersion": {"const": 2},
    "deliberationId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "minLength": 1},
    "task": {"const": "deliberate"},
    "mode": {"enum": ["plan-only", "preflight-only", "dry-run", "execute"]},
    "dryRun": {"type": "boolean"},
    "mutationCommitted": {"type": "boolean"},
    "artifactCommit": {
      "type": "object",
      "required": ["ledgerOnly", "runtimeState", "externalSystems"],
      "properties": {
        "ledgerOnly": {"type": "boolean"},
        "runtimeState": {"type": "boolean"},
        "externalSystems": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["planPath", "planHash", "taskTextChars"],
      "properties": {
        "planPath": {"type": ["string", "null"]},
        "planHash": {"type": ["string", "null"]},
        "taskTextChars": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "panel": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "executor",
          "verdict",
          "parsed",
          "success",
          "confidence",
          "concerns",
          "requiredChanges",
          "contentExcerpt"
        ],
        "properties": {
          "executor": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["approve", "block", "needs_changes", "skip"]},
          "parsed": {"type": "boolean"},
          "success": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "concerns": {
            "type": "array",
            "items": {"type": "string"}
          },
          "requiredChanges": {
            "type": "array",
            "items": {"type": "string"}
          },
          "contentExcerpt": {"type": "string"},
          "exitCode": {"type": "integer"},
          "durationMs": {"type": "integer", "minimum": 0},
          "tokenUsage": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "error": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "reviewerPolicy": {
      "type": "object",
      "required": [
        "policyVersion",
        "task",
        "riskLevel",
        "trustedReviewers",
        "requiredQuorum",
        "approvalCriteria"
      ],
      "properties": {
        "policyVersion": {"const": 1},
        "task": {"const": "deliberate"},
        "riskLevel": {"enum": ["low", "medium", "high", "critical"]},
        "trustedReviewers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "requiredQuorum": {"type": "integer", "minimum": 1},
        "approvalCriteria": {
          "type": "object",
          "required": ["verdict", "success", "parsed", "schema"],
          "properties": {
            "verdict": {"const": "approve"},
            "success": {"const": true},
            "parsed": {"const": true},
            "schema": {"const": "structured_json_v1"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "synthesizer": {
      "type": "object",
      "required": ["executor", "strategy"],
      "properties": {
        "executor": {"type": "string", "minLength": 1},
        "strategy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "consensus": {
      "type": "object",
      "required": [
        "status",
        "blockers",
        "dissent",
        "quorum",
        "overrideAllowed",
        "overrideAckToken"
      ],
      "properties": {
        "status": {"enum": ["approved", "blocked", "conflicted", "no_quorum"]},
        "blockers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "dissent": {
          "type": "object",
          "required": ["present", "summary"],
          "properties": {
            "present": {"type": "boolean"},
            "summary": {"type": "string"}
          },
          "additionalProperties": false
        },
        "quorum": {
          "type": "object",
          "required": [
            "status",
            "required",
            "countedApprovals",
            "trustedReviewers",
            "untrustedApprovals",
            "nonCompliantApprovals",
            "malformedReviewers"
          ],
          "properties": {
            "status": {
              "enum": [
                "satisfied",
                "insufficient_quorum",
                "malformed_reviewer_output",
                "missing_policy",
                "missing_quorum_evidence",
                "quorum_evidence_mismatch"
              ]
            },
            "required": {"type": "integer", "minimum": 0},
            "countedApprovals": {
              "type": "array",
              "items": {"type": "string"}
            },
            "trustedReviewers": {
              "type": "array",
              "items": {"type": "string"}
            },
            "untrustedApprovals": {
              "type": "array",
              "items": {"type": "string"}
            },
            "nonCompliantApprovals": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["executor", "reasons"],
                "properties": {
                  "executor": {"type": "string"},
                  "reasons": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                },
                "additionalProperties": false
              }
            },
            "malformedReviewers": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "additionalProperties": false
        },
        "overrideAllowed": {"type": "boolean"},
        "overrideAckToken": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "freshnessTtlSeconds": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
