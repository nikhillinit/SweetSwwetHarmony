{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sweetswwetharmony.local/hermes/task_result.schema.json",
  "title": "Hermes Track A Task Result",
  "type": "object",
  "required": ["task", "mode", "exitCode", "status", "plan", "checks", "outputs"],
  "properties": {
    "task": {"type": "string", "minLength": 1},
    "mode": {"enum": ["plan-only", "preflight-only", "dry-run", "execute"]},
    "exitCode": {"type": "integer"},
    "status": {"type": "string", "minLength": 1},
    "plan": {"type": "object"},
    "checks": {
      "type": "array",
      "items": {"$ref": "check_result.schema.json"}
    },
    "outputs": {"type": "object"}
  },
  "additionalProperties": false
}
