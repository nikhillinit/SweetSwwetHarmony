{
  "schemaVersion": 1,
  "executors": {
    "codex": {
      "provider": "codex",
      "displayName": "Codex CLI",
      "enabled": true,
      "required": true,
      "binary": "codex",
      "env": [],
      "supportsExecute": true
    },
    "kimi": {
      "provider": "kimi",
      "displayName": "Kimi",
      "enabled": true,
      "required": false,
      "binary": "kimi-cli",
      "env": [],
      "supportsExecute": true
    },
    "claude": {
      "provider": "claude",
      "displayName": "Claude CLI",
      "enabled": true,
      "required": false,
      "binary": "claude",
      "env": [],
      "supportsExecute": false
    },
    "gemini": {
      "provider": "gemini",
      "displayName": "Gemini CLI",
      "enabled": true,
      "required": false,
      "binary": "gemini",
      "env": [],
      "supportsExecute": true
    },
    "antigravity": {
      "provider": "antigravity",
      "displayName": "Google Antigravity",
      "enabled": false,
      "required": false,
      "binary": "antigravity",
      "env": [],
      "supportsExecute": false
    }
  },
  "deferredExecutors": {},
  "phases": {
    "planning": {
      "riskOrder": ["low", "medium", "high"],
      "preferredExecutors": ["codex"],
      "fallbackExecutors": ["kimi", "gemini", "claude"]
    },
    "development": {
      "riskOrder": ["medium", "high", "low"],
      "preferredExecutors": ["codex"],
      "fallbackExecutors": ["kimi", "gemini", "claude"]
    },
    "production": {
      "riskOrder": ["high", "medium", "low"],
      "preferredExecutors": ["codex"],
      "fallbackExecutors": ["kimi", "gemini", "claude"]
    }
  },
  "specialists": {
    "schema": {
      "keywords": ["schema", "migration", "database", "signal store", "sqlite"],
      "risk": "high",
      "preferredExecutors": ["codex"],
      "fallbackExecutors": ["kimi", "gemini"]
    },
    "thesis": {
      "keywords": ["thesis", "filter", "classifier", "false positive", "regression"],
      "risk": "medium",
      "preferredExecutors": ["kimi"],
      "fallbackExecutors": ["codex", "gemini"]
    },
    "security": {
      "keywords": ["secret", "token", "auth", "permission", "risk"],
      "risk": "high",
      "preferredExecutors": ["codex"],
      "fallbackExecutors": ["gemini", "claude"]
    },
    "docs": {
      "keywords": ["docs", "runbook", "handoff", "readme"],
      "risk": "low",
      "preferredExecutors": ["gemini"],
      "fallbackExecutors": ["claude", "codex"]
    },
    "durability": {
      "keywords": ["restore", "backup", "litestream"],
      "risk": "high",
      "preferredExecutors": ["codex"],
      "fallbackExecutors": ["kimi", "gemini"]
    }
  },
  "riskDefaults": {
    "noSpecialist": "medium",
    "highRiskKeywords": [
      "migration", "schema", "production", "delete from", "drop table", "delete data",
      "credential", "secret", "notion"
    ]
  },
  "routing": {
    "manualOverrideAllowed": true,
    "fallbackOrder": ["codex", "kimi", "gemini", "claude"],
    "unknownTaskExecutor": "codex"
  },
  "gates": {
    "preflight": [
      {
        "name": "hermes-tests",
        "command": ["python", "-m", "pytest", "tests/ops/hermes/", "-q"],
        "timeoutSeconds": 120
      }
    ],
    "postflight": []
  },
  "ledger": {
    "root": "ai-logs/hermes",
    "redactionPatterns": [
      "sk-[A-Za-z0-9_-]+",
      "secret_[A-Za-z0-9]+",
      "gh[pousr]_[A-Za-z0-9_]+",
      "xox[abp]-[A-Za-z0-9-]+",
      "AKIA[0-9A-Z]{16}",
      "Bearer\\s+[A-Za-z0-9._~+/=-]+",
      "ya29\\.[A-Za-z0-9._-]+",
      "(?i)(api[_-]?key|token|secret)=([^\\s]+)"
    ],
    "lockPath": "ai-logs/hermes/hermes.lock"
  },
  "modes": ["plan-only", "dry-run", "preflight-only", "execute"]
}
