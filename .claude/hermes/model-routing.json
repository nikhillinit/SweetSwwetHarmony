{
  "schemaVersion": 1,
  "executors": {
    "codex": {
      "provider": "codex",
      "displayName": "Codex CLI",
      "enabled": true,
      "required": true,
      "binary": "codex",
      "env": []
    },
    "kimi": {
      "provider": "kimi",
      "displayName": "Kimi",
      "enabled": true,
      "required": false,
      "env": [
        "KIMI_API_KEY"
      ]
    },
    "claude": {
      "provider": "claude",
      "displayName": "Claude CLI",
      "enabled": true,
      "required": false,
      "binary": "claude",
      "env": [],
      "supportsExecute": false
    }
  },
  "deferredExecutors": {
    "gemini": {
      "provider": "gemini",
      "reason": "Gemini CLI execution is deferred until adapter coverage and non-network doctor checks are approved."
    },
    "antigravity": {
      "provider": "antigravity",
      "reason": "Antigravity execution is deferred until a repo-owned adapter contract exists."
    }
  },
  "phases": {
    "planning": {
      "riskOrder": [
        "low",
        "medium",
        "high"
      ],
      "preferredExecutors": [
        "codex"
      ],
      "fallbackExecutors": [
        "kimi",
        "claude"
      ]
    },
    "development": {
      "riskOrder": [
        "medium",
        "high",
        "low"
      ],
      "preferredExecutors": [
        "codex"
      ],
      "fallbackExecutors": [
        "kimi",
        "claude"
      ]
    },
    "production": {
      "riskOrder": [
        "high",
        "medium",
        "low"
      ],
      "preferredExecutors": [
        "codex"
      ],
      "fallbackExecutors": [
        "kimi",
        "claude"
      ]
    }
  },
  "specialists": {
    "schema": {
      "keywords": [
        "schema",
        "migration",
        "database",
        "signal store",
        "sqlite"
      ],
      "risk": "high",
      "preferredExecutors": [
        "codex"
      ],
      "fallbackExecutors": [
        "kimi"
      ]
    },
    "thesis": {
      "keywords": [
        "thesis",
        "filter",
        "classifier",
        "false positive",
        "regression"
      ],
      "risk": "medium",
      "preferredExecutors": [
        "kimi"
      ],
      "fallbackExecutors": [
        "codex"
      ]
    },
    "security": {
      "keywords": [
        "secret",
        "token",
        "auth",
        "permission",
        "risk"
      ],
      "risk": "high",
      "preferredExecutors": [
        "codex"
      ],
      "fallbackExecutors": [
        "claude"
      ]
    },
    "docs": {
      "keywords": [
        "docs",
        "runbook",
        "handoff",
        "readme"
      ],
      "risk": "low",
      "preferredExecutors": [
        "claude"
      ],
      "fallbackExecutors": [
        "codex"
      ]
    }
  },
  "riskDefaults": {
    "noSpecialist": "medium",
    "highRiskKeywords": [
      "migration",
      "schema",
      "production",
      "delete",
      "credential",
      "secret",
      "notion"
    ]
  },
  "routing": {
    "manualOverrideAllowed": true,
    "fallbackOrder": [
      "codex",
      "kimi",
      "claude"
    ],
    "unknownTaskExecutor": "codex"
  },
  "gates": {
    "preflight": [
      {
        "name": "hermes-tests",
        "command": [
          "python",
          "-m",
          "pytest",
          "tests/ops/hermes/",
          "-q"
        ],
        "timeoutSeconds": 120
      }
    ],
    "postflight": []
  },
  "ledger": {
    "root": "ai-logs/hermes",
    "redactionPatterns": [
      "sk-[A-Za-z0-9_-]+",
      "secret_[A-Za-z0-9]+",
      "gh[pousr]_[A-Za-z0-9_]+",
      "xox[abp]-[A-Za-z0-9-]+",
      "AKIA[0-9A-Z]{16}",
      "Bearer\\s+[A-Za-z0-9._~+/=-]+",
      "ya29\\.[A-Za-z0-9._-]+",
      "(?i)(api[_-]?key|token|secret)=([^\\s]+)"
    ],
    "lockPath": "ai-logs/hermes/hermes.lock"
  },
  "modes": [
    "plan-only",
    "dry-run",
    "preflight-only",
    "execute"
  ]
}
