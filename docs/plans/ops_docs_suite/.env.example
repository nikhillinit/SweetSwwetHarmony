# Copy to .env (do not commit .env)

# --- LLM Provider ---
# Provide at least one of these:
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Optional model selection
GEMINI_MODEL=

# Output control
MAX_OUTPUT_TOKENS=800

# --- Ops pacing / budgets ---
DAILY_LLM_BUDGET=0.0
MAX_EXTRACTION_ATTEMPTS=3
EXTRACTION_SLEEP_SECONDS=1.5

# --- Briefing tuning ---
BRIEFING_SIMILARITY_THRESHOLD=0.85
BRIEFING_JACCARD_PREFILTER=0.15
BRIEFING_TOKEN_BUDGET=2200
